{
  "manifestVersion": 1,
  "id": "com.penkra.sample",
  "slug": "sample",
  "name": "Sample",
  "summary": "A complete framework-neutral Penkra App example.",
  "version": "0.1.0",
  "compatibility": { "penkra": ">=0.8.0" },
  "icons": [{ "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }],
  "entrypoints": { "app": "app.html", "operations": "operations.html" },
  "permissions": [{ "name": "network-fetch", "required": false, "reason": "Demonstrate optional permission inspection." }],
  "operations": [{
    "key": "notes.create",
    "summary": "Create a note, optionally asking for confirmation in an App tab.",
    "input": { "type": "object", "properties": { "text": { "type": "string", "minLength": 1 }, "confirm": { "type": "boolean" } }, "required": ["text", "confirm"], "additionalProperties": false },
    "output": { "type": "object", "properties": { "saved": { "type": "boolean" } }, "required": ["saved"], "additionalProperties": false },
    "handler": "notes.create"
  }]
}

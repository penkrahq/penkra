{
  "name": "@penkra/sdk",
  "version": "0.1.1",
  "description": "Framework-neutral SDK for building secure Penkra Apps.",
  "keywords": [
    "apps",
    "penkra",
    "sdk"
  ],
  "homepage": "https://github.com/penkrahq/penkra/tree/main/packages/sdk#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penkrahq/penkra.git",
    "directory": "packages/sdk"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src/*.ts",
    "!src/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/react.ts --format esm,cjs --dts --clean",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}

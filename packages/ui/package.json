{
  "name": "@penkra/ui",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./src/tokens.css",
    "./app-bar.css": "./src/app-bar.css"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

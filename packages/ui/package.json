{
  "name": "@penkra/ui",
  "version": "0.1.0",
  "description": "Framework-neutral UI tokens and primitives for Penkra Apps.",
  "keywords": [
    "apps",
    "design-system",
    "penkra",
    "ui"
  ],
  "homepage": "https://github.com/penkrahq/penkra/tree/main/packages/ui#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penkrahq/penkra.git",
    "directory": "packages/ui"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src/*.css",
    "src/*.ts",
    "src/*.tsx",
    "!src/*.test.ts"
  ],
  "type": "module",
  "sideEffects": [
    "./src/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    },
    "./tokens.css": "./src/tokens.css",
    "./app-bar.css": "./src/app-bar.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/react.tsx --format esm,cjs --dts --clean",
    "prepack": "bun run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "happy-dom": "^20.11.1",
    "react": "^19.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}

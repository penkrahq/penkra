{
  "name": "@penkra/ui",
  "version": "0.1.0",
  "files": [
    "dist",
    "src/*.css",
    "src/*.ts",
    "src/*.tsx",
    "!src/*.test.ts"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./src/react.tsx",
      "import": "./src/react.tsx",
      "require": "./dist/react.cjs"
    },
    "./tokens.css": "./src/tokens.css",
    "./app-bar.css": "./src/app-bar.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/react.tsx --format esm,cjs --dts --clean",
    "prepack": "bun run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "happy-dom": "^20.11.1",
    "react": "^19.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}

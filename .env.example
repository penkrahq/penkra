# Source builds use Penkra's production account services when these are omitted.
# Set both values together to use a compatible self-hosted or local backend.
#
# PENKRA_API_URL=http://127.0.0.1:3012
# PENKRA_WEBSITE_ORIGIN=http://localhost:3000

# Packaged production builds pin one or more registry Ed25519 public JWKs.
# Loopback development discovers the current local key from the local backend.
# PENKRA_REGISTRY_TRUSTED_KEYS=[{"kty":"OKP","crv":"Ed25519","x":"...","kid":"...","alg":"EdDSA","use":"sig"}]

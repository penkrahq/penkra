{
  "name": "penkra",
  "version": "0.1.0",
  "private": true,
  "description": "Penkra interactive product prototype",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:install-app": "node scripts/install-penkra-dev-app.mjs",
    "dev:launch": "node scripts/dev-launcher.mjs launch",
    "dev:status": "node scripts/dev-launcher.mjs status",
    "build": "tsc --noEmit && vite build",
    "capture:designs": "npm run build && electron electron/capture-designs.cjs",
    "smoke": "npm run build && electron electron/smoke.cjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^40.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}

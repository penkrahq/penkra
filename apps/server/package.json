{
  "name": "@penkra/cli",
  "version": "0.11.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emanuele-web04/Penkra.git",
    "directory": "apps/server"
  },
  "bin": {
    "penkra": "dist/index.mjs",
    "penkra-database": "dist/databaseMaintenance.mjs",
    "penkra-restore-migration-backup": "dist/restoreMigrationBackup.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:bundle": "tsdown && tsdown --watch --no-clean",
    "build": "node scripts/cli.ts build",
    "start": "node dist/index.mjs",
    "prepare": "effect-language-service patch",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:isolated && bun run test:serial",
    "test:isolated": "vitest run src/git/Layers/GitCore.test.ts src/git/Layers/GitManager.test.ts src/orchestration/Layers/CheckpointReactor.test.ts --maxWorkers=3 --fileParallelism --silent=passed-only",
    "test:serial": "vitest run --maxWorkers=1 --no-file-parallelism --exclude src/git/Layers/GitCore.test.ts --exclude src/git/Layers/GitManager.test.ts --exclude src/orchestration/Layers/CheckpointReactor.test.ts --silent=passed-only"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.207",
    "@anthropic-ai/sdk": "^0.100.0",
    "@earendil-works/pi-agent-core": "^0.81.1",
    "@earendil-works/pi-ai": "^0.81.1",
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@effect/platform-node": "catalog:",
    "@opencode-ai/sdk": "^1.15.13",
    "@penkra/sdk": "workspace:*",
    "@pierre/diffs": "^1.2.12",
    "@xterm/headless": "^6.0.0",
    "effect": "catalog:",
    "jsonc-parser": "3.3.1",
    "node-pty": "^1.1.0",
    "open": "^10.1.0",
    "semver": "^7.7.4",
    "socket.io-client": "^4.8.3",
    "tree-kill": "^1.2.2",
    "ws": "^8.21.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@penkra/contracts": "workspace:*",
    "@penkra/shared": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.5.13",
    "@types/yazl": "3.3.0",
    "socket.io": "^4.8.3",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "4.3.6"
  },
  "engines": {
    "node": "^24.15.0"
  }
}

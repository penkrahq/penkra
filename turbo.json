{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "PENKRA_HOME",
    "PENKRA_DESKTOP_WS_URL",
    "PENKRA_BROWSER_PERF",
    "PENKRA_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "PENKRA_GROK_ACP_DEBUG",
    "PENKRA_WEB_SOURCEMAP",
    "PENKRA_SERVER_SOURCEMAP",
    "PENKRA_DESKTOP_SOURCEMAP",
    "PENKRA_MODE",
    "PENKRA_PORT",
    "PENKRA_NO_BROWSER",
    "PENKRA_AUTH_TOKEN",
    "PENKRA_PUBLIC_URL",
    "PENKRA_ALLOW_INSECURE_REMOTE",
    "PENKRA_LOG_WS_EVENTS",
    "PENKRA_HOST",
    "PENKRA_AUTO_BOOTSTRAP_PROJECT_FROM_CWD",
    "PENKRA_API_URL",
    "PENKRA_WEBSITE_ORIGIN",
    "PENKRA_DEV_INSTANCE_NUMBER",
    "PENKRA_SKIP_LOGIN_SHELL_ENVIRONMENT",
    "PENKRA_VOICE_QA_WAV",
    "PENKRA_ROOT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}

+import { it, expect } from "vitest";
+import { writeFileSync } from "node:fs";
+import { projectProviderRuntimeActivities } from "./orchestration/providerRuntimeActivityProjection.ts";
+import { deriveWorkLogEntries } from "../../web/src/workLog.ts";
+import { deriveActiveTaskListState } from "../../web/src/session-logic.ts";
+import { toCleanCoreProviderEvents } from "./cleanCore/providerEventBridge.ts";
+
+it("QA0144 identical event presentation", () => {
+ const records = [];
+ for (const provider of ["claudeAgent", "codex"] as const) {
+  const base = { eventId: `qa-${provider}`, provider, threadId: "qa-thread", turnId: "qa-turn", createdAt: "2026-10-13T22:00:00.000Z" };
+  for (const event of [
+   {...base, type: "task.progress", payload: {taskId: "qa-task", description: "Reviewing the release", summary: "Checked the desktop rollout"}},
+   {...base, type: "turn.tasks.updated", payload: {tasks: [{task: "Inspect release", status: "completed"}, {task: "Verify runtime", status: "inProgress"}], explanation: "Release checks"}},
+   {...base, type: "thread.state.changed", payload: {state: "compacted", detail: {source: "provider"}}},
+   {...base, itemId: "qa-compaction", type: "item.completed", payload: {itemType: "context_compaction", status: "completed"}}
+  ]) {
+   const old = projectProviderRuntimeActivities(event as any);
+   const canonical = toCleanCoreProviderEvents(event as any);
+   const delivered = canonical.filter((entry: any) => entry.type === "item" && entry.item.data).map((entry: any) => ({id: entry.item.sourceId, createdAt: entry.item.createdAt, turnId: entry.item.turnId, ...JSON.parse(entry.item.data)}));
+   const record = {provider, type: event.type, legacyProjection: old, canonical, work: deriveWorkLogEntries(delivered as any, "qa-turn" as any), panel: deriveActiveTaskListState(delivered as any, "qa-turn" as any)};
+   records.push(record);
+   console.log("QA0144_EVENT", JSON.stringify(record));
+  }
+ }
+ writeFileSync(process.env.PENKRA_HOME + "/events.json", JSON.stringify(records, null, 2));
+ expect(records).toHaveLength(8);
+});
